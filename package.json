{
  "name": "clamp-ireland",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-map-assets.mjs",
    "dev": "next dev",
    "dev:admin": "next dev apps/admin --port 3003",
    "prebuild": "node scripts/prepare-map-assets.mjs",
    "build": "next build",
    "build:admin": "next build apps/admin",
    "build:all": "npm run build && npm run build:admin",
    "start": "next start",
    "start:admin": "next start apps/admin --port 3003",
    "db": "node --env-file-if-exists=.env.local scripts/database.mjs",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:unit": "node scripts/ci/run.mjs unit",
    "test:sql": "node scripts/ci/run.mjs sql",
    "test:smoke": "node scripts/ci/run.mjs smoke",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test:infra": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\" && az bicep build --file infra/legacy-container-apps/main.bicep --outfile test-results/infra.json && node --test scripts/infra/*.test.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.33.0",
    "geographiclib-geodesic": "^2.2.0",
    "openid-client": "^6.8.8",
    "maplibre-gl": "^6.9.1",
    "heic-decode": "^2.1.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
