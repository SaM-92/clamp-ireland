# Private admin app settings. Do not put real account IDs or secrets in git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Two distinct, existing, email-confirmed Supabase user UUIDs.
# Both profiles must also have is_admin=true and is_banned=false.
ADMIN_ALLOWED_USER_IDS=
# Exact trusted origin, not a redirect destination supplied by a browser.
ADMIN_SITE_URL=http://localhost:3003

ENABLE_TRAFFIC_ANALYTICS=false
ENABLE_AREA_SUMMARIES=false
OPENAI_API_KEY=

# Azure model calls are server-only. Reuse an existing GPT-5 mini deployment.
# Entra uses Azure CLI locally and the app's managed identity in production.
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_AUTH_MODE=entra
AZURE_OPENAI_API_KEY=
AZURE_CLIENT_ID=
