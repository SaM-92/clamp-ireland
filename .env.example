# One absolute SQLite path on persistent LOCAL disk, shared by both processes.
# Windows example: Q:\Repos\ClampIreland\.local\clamp.sqlite
# Linux/containers example: /data/clamp.sqlite
# Never use ephemeral container storage, Azure Files/SMB/NFS or two hosts.
DATABASE_PATH=
AUTH_PUBLIC_ORIGIN=http://localhost:3001
# Google OAuth web-client settings. Server-only; never NEXT_PUBLIC.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified Google email invitations, comma-separated, only for new accounts.
# Existing accounts may still sign in; banning is a separate profile setting.
AUTH_ALLOWED_EMAILS=
ALLOW_PUBLIC_SIGNUP=false

# Map tiles — OpenFreeMap is free with no signup/key. Swap for a MapTiler
# style URL (also free-tier) if you outgrow it — see docs/01-architecture.md.
NEXT_PUBLIC_MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/bright

# Hosted support checkout — your real Stripe Payment Link / Ko-fi /
# Buy Me a Coffee / GitHub Sponsors URL. Leave blank until configured.
NEXT_PUBLIC_DONATION_URL=

# Private processed photo evidence; no storage keys or connection strings.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_AUTH_MODE=managed-identity
# For a local developer with explicitly assigned Blob permissions, use azure-cli.

# Canonical public HTTPS origin, e.g. https://your-real-domain.ie (no path).
# Keep indexing off until the public site, privacy policies and moderation are ready.
SITE_URL=
ALLOW_INDEXING=false

# Optional daily aggregate pageview counts in SQLite (30-day retention).
# No application-stored visitor identifiers, search text or report content.
# Disabled by default; review privacy notices before enabling in production.
ENABLE_TRAFFIC_ANALYTICS=false

# Display already human-reviewed 500 m summaries.
# The community app only reads approved cache entries; it never generates them.
ENABLE_AREA_SUMMARIES=false
# Administrator settings belong only in apps/admin/.env.local.
# Public summary reads still require no model credentials. Content checking on
# report/username writes uses a separate server identity with inference access.
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_AUTH_MODE=entra
AZURE_OPENAI_API_KEY=
AZURE_CLIENT_ID=

# Development only; fixed synthetic examples, never private reports.
ENABLE_LOCAL_AI_DEMO=false
