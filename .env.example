# Supabase project (create a free one at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server-only secret, never expose to the browser

# Map tiles — OpenFreeMap is free with no signup/key. Swap for a MapTiler
# style URL (also free-tier) if you outgrow it — see docs/01-architecture.md.
NEXT_PUBLIC_MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Donations placeholder — replace with your real Buy Me a Coffee / Ko-fi /
# GitHub Sponsors link before launch.
NEXT_PUBLIC_DONATION_URL=https://www.buymeacoffee.com/clampireland

# Optional: powers the AI text-softening pass for report descriptions.
# Falls back to a simple heuristic softener when unset — see
# src/modules/reports/server/textSoftening.ts.
OPENAI_API_KEY=
